# Copy to `.env.local` (or `.env` for local dev). Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable API key (`sb_publishable_...`) — safe to expose to the browser.
# Use this when adding a Supabase Browser client or Auth on the client; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret API key (`sb_secret_...`) — server-side only (bypasses RLS). Prefer this name.
SUPABASE_SECRET_KEY=your-secret-key

# Legacy fallback: JWT `service_role` key from the dashboard “Legacy keys” tab.
# SUPABASE_SERVICE_ROLE_KEY=...

# Temporary static login (until real auth + database are connected)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Cookie value issued after login — change in production
AUTH_SESSION_TOKEN=cbs-dev-session-token
