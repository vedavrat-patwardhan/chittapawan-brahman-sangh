# Copy to `.env.local` (or `.env` for local dev). Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas: Database → Connect → Drivers. Local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name (created automatically on first write)
MONGODB_DB=chitpavan

# Optional emergency/bootstrap admin. Prefer `npm run admin:create` for admins.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_ADMIN_NAME=

# Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=
